# Copy this file to `.env` and fill in your keys.
# Get them free at https://app.alpaca.markets  ->  "Paper Trading" -> "API Keys"
#
# IMPORTANT: never commit your real .env file. It is already in .gitignore.

ALPACA_API_KEY=your_paper_key_here
ALPACA_SECRET_KEY=your_paper_secret_here

# Leave this as the paper endpoint. Changing it to the live URL trades real money.
ALPACA_PAPER=true
